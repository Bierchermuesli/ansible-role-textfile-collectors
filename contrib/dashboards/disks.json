    {
      "id": 9,
      "type": "table",
      "title": "disks",
      "description": "One row per device from smartctl. The attribute columns are SATA only: smartmon.sh parses ATA attributes, NVMe devices show up here with health and identity but get their wear data from the nvme_metrics collector below (needs nvme-cli 2.4+, i.e. trixie).",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "smartmon_device_info{instance=~\"$instance\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_device_smart_healthy{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_temperature_celsius_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_power_on_hours_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_reallocated_sector_ct_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_current_pending_sector_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_offline_uncorrectable_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, disk, type) (smartmon_udma_crc_error_count_raw_value{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
        }
      ],
