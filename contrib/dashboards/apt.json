{
  "annotations": {
    "list": []
  },
  "description": "Fleet-wide view of pending apt upgrades, reboots and apt cache freshness. Metrics come from the apt_info and deleted_libraries collectors in ansible-role-textfile-collectors (apt_info.prom via node_exporter's textfile collector).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "ansible-role-textfile-collectors",
      "type": "link",
      "url": "https://github.com/Bierchermuesli/ansible-role-textfile-collectors",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "liveNow": false,
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "apt",
    "upgrades",
    "textfile-collectors",
    "deleted-libraries"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "label": "Metrics datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(apt_package_cache_timestamp_seconds, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(apt_package_cache_timestamp_seconds, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "apt upgrades",
  "uid": "apt-upgrades",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "hosts reporting",
      "description": "Hosts whose apt_info collector delivered data. Compare with the number of hosts you expect; a missing host means node_exporter or the collector is down there.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(apt_package_cache_timestamp_seconds{instance=~\"$instance\"})",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "hosts with upgrades",
      "description": "Hosts with at least one pending upgrade.",
