    {
      "id": 9,
      "type": "table",
      "title": "hosts",
      "description": "One row per host. Sorted by pending upgrades. obsolete = installed packages no longer in any configured repository (leftovers after a release upgrade). cache age = time since the last apt update; collector age = time since apt_info.prom was written (timer: hourly). stale libs = processes still using a replaced library; restart those services (or the host) to finish the upgrade.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
