        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(sum by (instance) (apt_upgrades_pending{instance=~\"$instance\"}) > 0) or vector(0)",
          "legendFormat": "",
          "instant": true
