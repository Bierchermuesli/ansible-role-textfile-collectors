      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance) (apt_upgrades_pending{instance=~\"$instance\"})",
          "format": "table",
          "instant": true
