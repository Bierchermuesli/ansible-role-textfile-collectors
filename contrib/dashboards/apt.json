              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 7,
              "Value #G": 8,
              "Value #H": 9,
              "Value #I": 6
            },
            "renameByName": {
              "instance": "host",
              "Value #A": "pending",
              "Value #B": "security",
              "Value #C": "held",
              "Value #D": "autoremove",
              "Value #E": "obsolete",
              "Value #F": "reboot",
              "Value #G": "cache age",
              "Value #H": "collector age",
              "Value #I": "stale libs"
            }
          }
